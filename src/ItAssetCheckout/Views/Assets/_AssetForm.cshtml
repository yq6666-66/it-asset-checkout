@model Asset

<div class="field">
    <label asp-for="TagNo"></label>
    <input asp-for="TagNo" />
    <span asp-validation-for="TagNo"></span>
</div>
<div class="field">
    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>
</div>
<div class="field">
    <label asp-for="Category"></label>
    <input asp-for="Category" placeholder="Laptop, monitor, phone" />
    <span asp-validation-for="Category"></span>
</div>
<div class="field">
    <label asp-for="Status"></label>
    <select asp-for="Status">
        <option value="">Select status</option>
        @foreach (var status in AssetStatus.All)
        {
            <option value="@status">@status</option>
        }
    </select>
    <span asp-validation-for="Status"></span>
</div>
<div class="field">
    <label asp-for="PurchaseDate"></label>
    <input asp-for="PurchaseDate" type="date" />
    <span asp-validation-for="PurchaseDate"></span>
</div>
<div class="field">
    <label asp-for="Value"></label>
    <input asp-for="Value" step="0.01" />
    <span asp-validation-for="Value"></span>
</div>
