@{
    ViewData["Title"] = "Home";
}

<section class="banner">
    <p class="eyebrow">Equipment desk</p>
    <h1>Know which kit is on the shelf.</h1>
    <p>Record each device, the person who holds it, and the date it is due back.</p>
    <a class="button" asp-controller="Assets" asp-action="Index">View assets</a>
</section>

<section class="home-grid">
    <article>
        <h2>Tag numbers</h2>
        <p>Every item keeps a unique tag so two laptops are never mixed up.</p>
    </article>
    <article>
        <h2>Status</h2>
        <p>Mark a device available, in use, in maintenance, or retired.</p>
    </article>
    <article>
        <h2>Checkouts</h2>
        <p>An asset can have only one open checkout. Sign in to record staff and loans.</p>
    </article>
</section>
